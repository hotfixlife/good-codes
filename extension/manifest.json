{
  "manifest_version": 3,
  "name": "Good Codes",
  "version": "0.6.1",
  "description": "Promo codes other shoppers say actually work. Copy one at checkout, then tell us if it worked.",
  "permissions": ["storage", "alarms", "declarativeContent", "activeTab", "scripting"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Good Codes",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" }
}
