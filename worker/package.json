{
  "name": "goodcodes-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --no-warnings test/core.test.js",
    "build": "node ../build.mjs",
    "build:dev": "node ../build.mjs --dev",
    "db:local": "wrangler d1 execute fairshare --local --file schema.sql",
    "db:remote": "wrangler d1 execute fairshare --remote --file schema.sql",
    "dev": "wrangler dev",
    "deploy": "node ../build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "wrangler": "^4.20.0"
  }
}
